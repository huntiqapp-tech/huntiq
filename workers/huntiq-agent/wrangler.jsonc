{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huntiq-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "HuntiqAgent",
        "name": "HuntiqAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HuntiqAgent"]
    }
  ],
  "observability": {
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
